# Copy to .env and adjust. The API reads this file in development.

# PostgreSQL connection (docker compose up -d db starts one with these credentials)
DATABASE_URL=postgres://helm:helm@localhost:5432/helm

# Integration tests create throwaway databases on this server (the role needs CREATEDB)
TEST_DATABASE_URL=postgres://helm:helm@localhost:5432/helm_test

PORT=3000

# Docker Compose only: the ports Helm and its database use on this machine. Change them when
# another program already uses 3000 or 5432 (then change the port in DATABASE_URL above too, if
# you also run Helm with npm). HELM_PORT=127.0.0.1:3000 accepts connections from this machine
# only, for a reverse proxy running on it.
# HELM_PORT=3000
# HELM_DB_PORT=5432

# First administrator, created on first start when the users table is empty.
# If HELM_ADMIN_PASSWORD is empty a random password is generated and printed once to the log.
# The admin must change it at first login.
HELM_ADMIN_USERNAME=admin
HELM_ADMIN_PASSWORD=

# Session lifetime (sliding) and cookie security. Set COOKIE_SECURE=true behind HTTPS.
SESSION_TTL_HOURS=12
COOKIE_SECURE=false
# Set TRUST_PROXY=true behind a reverse proxy so client IPs (rate limits, audit log) are correct.
TRUST_PROXY=false

# Optional settings, shown with their defaults.
# HOST=0.0.0.0
# LOG_LEVEL=info
# DATABASE_POOL_MAX=10
# MIGRATE_ON_START=true
# HELM_ADMIN_DISPLAY_NAME=Administrator
# Failed sign-ins before an account is locked, and for how long.
# LOCKOUT_THRESHOLD=5
# LOCKOUT_MINUTES=15
# LOGIN_RATE_LIMIT_PER_MINUTE=20
# Where the built web app is; defaults to apps/web/dist when it exists.
# WEB_DIST_DIR=
# Keys saved on the AI assistant page are encrypted with a secret the server generates on first
# use in HELM_DATA_DIR (default: data/ in the repository; /app/data in Docker). Back it up with the
# database. To manage it yourself instead, set HELM_SECRET_KEY (at least 32 random characters).
# HELM_DATA_DIR=
# HELM_SECRET_KEY=

# AI features (Azure OpenAI). The easy way: leave these empty and connect Azure OpenAI from
# Administration → AI assistant in Helm. Setting all three here instead makes that page read-only.
# Endpoint and key: Azure portal → your Azure OpenAI resource → Keys and Endpoint.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
# The name you gave your GPT-4o deployment (Azure AI Foundry → Deployments).
AZURE_OPENAI_DEPLOYMENT=
# AZURE_OPENAI_API_VERSION=2024-10-21
# AI_TIMEOUT_SECONDS=60
